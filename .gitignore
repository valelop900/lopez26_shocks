# git only tracks the files I list here

/*

!/.gitignore
!/README.md
!/LICENSE
!/figures
!/data
!/notes
!/plots
!/zenodo

# the paper figures
/figures/*
!/figures/fig_bpt_2panel.pdf
!/figures/fig_w80_2panel.pdf
!/figures/fig_loi_vs_q.pdf
!/figures/fig_oiii_profiles.pdf
!/figures/fig_examples.pdf

# the catalogs the scripts read
# I leave out the raw VLASS and DESI tables, the spectra and the cutouts, they are public
/data/*
!/data/catalog_small.csv
!/data/catalog_large.csv
!/data/catalog_small_Q.csv
!/data/catalog_large_Q.csv

# the line fit tables the scripts read
/notes/*
!/notes/2026-07-08_oiii_fits.csv
!/notes/2026-07-09_oi_fits.csv
!/notes/2026-07-13_resolution_w80.csv
!/notes/2026-07-15_hbeta_fits.csv
!/notes/2026-07-16_halpha_fits.csv
!/notes/2026-07-22_halpha_fits_new_large.csv
!/notes/2026-07-22_hbeta_fits_new_large.csv
!/notes/2026-07-22_oi_fits_new_large.csv
!/notes/2026-07-22_oiii_fits_new_large.csv
!/notes/2026-07-22_w80_new_large.csv
!/notes/2026-07-28_luminosity_check.csv
!/notes/2026-07-31_bpt_class_lumcut_v2.csv
!/notes/2026-07-31_halpha_fits_new_small24.csv
!/notes/2026-07-31_hbeta_fits_new_small24.csv
!/notes/2026-07-31_oi_fits_new_small24.csv
!/notes/2026-07-31_oiii_fits_new_small24.csv
!/notes/2026-07-31_w80_new_small24.csv
!/notes/2026-09-18_oiii_dv_all.csv

# the scripts save plots here
/plots/*
!/plots/.gitkeep

# the zenodo files
/zenodo/*
!/zenodo/upload
!/zenodo/make_release_tables.py
!/zenodo/make_manifest.py
!/zenodo/metadata.json
!/zenodo/description_for_zenodo.txt

# the figure scripts
!/scripts
/scripts/*
!/scripts/paperstyle.py
!/scripts/fig_bpt_2panel.py
!/scripts/fig_w80_2panel.py
!/scripts/plot_loi_vs_q.py
!/scripts/oiii_profiles.py
!/scripts/fig_examples.py

# the number check
!/checks
/checks/*
!/checks/verify_revision_numbers.py

# junk
.DS_Store
._*
__pycache__/
*.pyc
.Rhistory
*.fits
*.fits.gz